          <techName>Radome</techName>
          <infoName>Lightning-Diverter Bonding Check</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>

    <dmStatus issueType="new">
      <security securityClassification="01"/>

      <responsiblePartnerCompany>
        <enterpriseName>GQAOA — AMPEL360</enterpriseName>
      </responsiblePartnerCompany>

      <originator>
        <enterpriseName>Q-DATAGOV</enterpriseName>
      </originator>

      <applic>
        <displayText>
          <simplePara>AMPEL360 eWTW, baseline configuration, MSN-001 to MSN-050.</simplePara>
        </displayText>
        <evaluate andOr="and">
          <assert
            applicPropertyIdent="programme"
            applicPropertyType="prodattr"
            applicPropertyValues="AMPEL360"/>
          <assert
            applicPropertyIdent="product"
            applicPropertyType="prodattr"
            applicPropertyValues="eWTW"/>
          <assert
            applicPropertyIdent="config"
            applicPropertyType="condition"
            applicPropertyValues="baseline"/>
          <assert
            applicPropertyIdent="msn"
            applicPropertyType="prodattr"
            applicPropertyValues="001~050"/>
        </evaluate>
      </applic>

      <brexDmRef>
        <dmRef>
          <dmRefIdent>
            <dmCode
              modelIdentCode="AMPEL360"
              systemDiffCode="A"
              systemCode="02"
              subSystemCode="2"
              subSubSystemCode="0"
              assyCode="00"
              disassyCode="00"
              disassyCodeVariant="A"
              infoCode="00W"
              infoCodeVariant="A"
