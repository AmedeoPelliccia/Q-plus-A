     Source of truth: ../../SSOT/

     Rule SSOT-AUTHORITY-001:
       Content derives from SSOT; never originates here.

     Ownership boundary:
       The radome publication checks radome-side bonding provisions and
       installed interface condition. The lightning-protection system owns
       lightning-diverter design, current-path architecture, and lightning
       substantiation.

     DMC identity:
       modelIdentCode = AMPEL360
       systemDiffCode = A
       systemCode = 53
       eWTW product variant is controlled through applicability.
     ==================================================================== -->
<dmodule
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://www.s1000d.org/S1000D_5-0/xml_schema_flat/proced.xsd">

  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode
          modelIdentCode="AMPEL360"
          systemDiffCode="A"
          systemCode="53"
          subSystemCode="1"
          subSubSystemCode="0"
          assyCode="10"
          disassyCode="00"
          disassyCodeVariant="A"
          infoCode="258"
          infoCodeVariant="A"
          itemLocationCode="D"/>
        <language languageIsoCode="en" countryIsoCode="GB"/>
